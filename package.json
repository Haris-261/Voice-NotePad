{
  "name": "voice-notepad-pwa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:frontend\" \"npm:dev:admin\" \"npm:server\"",
    "dev:frontend": "vite --config frontend/vite.config.js frontend --port 5173",
    "dev:admin": "vite --config admin/vite.config.js admin --port 5174",
    "build": "npm run build:frontend && npm run build:admin",
    "build:frontend": "vite build --config frontend/vite.config.js frontend",
    "build:admin": "vite build --config admin/vite.config.js admin",
    "preview": "vite preview --config frontend/vite.config.js frontend",
    "server": "node backend/local.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dexie": "^4.0.11",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "html-to-image": "^1.11.13",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "mongoose": "^8.9.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1"
  }
}
